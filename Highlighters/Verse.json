{
  "Highlighter": {
    "Sample": [
      "# Hello, World! in Verse\r\n",
      "\r\n",
      "Greet(Name:string)<computes>:string =\r\n",
      "    \"Hello, {Name}!\"\r\n",
      "\r\n",
      "Main():void =\r\n",
      "    Print(Greet(\"world\"))"
