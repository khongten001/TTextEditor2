{
  "Highlighter": {
    "Sample": [
      "// Hello, World! in G#\r\n",
      "\r\n",
      "package Hello\r\n",
      "import System\r\n",
      "\r\n",
      "func greet(name string) string {\r\n",
      "    return \"Hello, ${name}!\"\r\n",
      "}\r\n",
      "\r\n",
      "Console.WriteLine(greet(\"world\"))"
    ],
    "MainRules": {
      "Attributes": {
        "Element": "Editor"
      },
      "SubRules": {
        "Range": [
          {
            "Type": "BlockComment",
            "Attributes": {
              "Element": "Comment"
            },
            "TokenRange": {
              "Open": "/*",
              "Close": "*/"
            }
          },
          {
            "Type": "LineComment",
            "Attributes": {
