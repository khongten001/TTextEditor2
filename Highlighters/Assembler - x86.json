{
  "Highlighter": {
    "Sample": [
      "; Hello, World! in x86-64 assembly (NASM, Linux)\r\n",
      "\r\n",
      "section .data\r\n",
      "message: db \"Hello, World!\", 10\r\n",
      "\r\n",
      "section .text\r\n",
      "global _start\r\n",
      "\r\n",
      "_start:\r\n",
      "  mov rax, 1          ; sys_write\r\n",
      "  mov rdi, 1          ; stdout\r\n",
      "  mov rsi, message    ; buffer\r\n",
      "  mov rdx, 14         ; length\r\n",
      "  syscall\r\n",
      "\r\n",
      "  mov rax, 60         ; sys_exit\r\n",
      "  xor rdi, rdi\r\n",
      "  syscall"
    ],
