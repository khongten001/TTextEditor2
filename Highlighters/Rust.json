      "// Hello, World! in Rust\r\n",
      "\r\n",
      "fn greet<'a>(name: &'a str) -> String {\r\n",
      "    format!(\"Hello, {}!\", name)\r\n",
      "}\r\n",
      "\r\n",
      "fn main() {\r\n",
      "    let raw = r#\"C:\\temp\"#;\r\n",
      "    let bytes = b\"bytes\";\r\n",
      "    let c = '\\n';\r\n",
      "    let n = 0b1010 + 0o17 + 0xFF_u8 as i32;\r\n",
      "    println!(\"{} {} {:?} {} {}\", greet(\"World\"), raw, bytes, c, n);\r\n",
      "}"
